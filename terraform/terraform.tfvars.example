# setup.sh generates terraform.tfvars on a fresh machine. To write it by hand,
# copy this file to terraform.tfvars and set the values for your machine.

qemu_uid = "64055"   # id -u libvirt-qemu
kvm_gid  = "991"     # getent group kvm | cut -d: -f3

# vm_user          = "ubuntu"
# opnsense_machine = "pc-i440fx-resolute"   # qemu-system-x86_64 -machine help
# server_machine   = "pc-q35-10.2"
console_password_hash = "$6$..."   # openssl passwd -6
