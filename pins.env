# pins.env: every pinned version, checksum and signing key, in ONE place.
# Read by setup.sh. When a check fails: verify the new value through an independent
# source, update the line here, and say how you verified it in the commit message.

# HashiCorp's Linux package signing key (Terraform, Packer). Rotated 2026-09-09; checked
# against https://www.hashicorp.com/trust/security (not the repository host) on 2026-10-02.
HASHICORP_FPR=D55C0D1AC78A8D8126CB631CFC9CA96ACA026560

# OPNsense release for the golden image. Only pkg.opnsense.org keeps older releases;
# mirrors carry the newest major only. The .bz2 checksum is OPNsense's published value;
# the .iso checksum is what that file decompresses to, and it also matches the ISO that
# built the original golden image on mera-server (both checked 2026-10-02).
OPNSENSE_VERSION=26.1
OPNSENSE_URL=https://pkg.opnsense.org/releases/26.1/OPNsense-26.1-dvd-amd64.iso.bz2
OPNSENSE_BZ2_SHA256=856c00a4ddf62f40cdc0871cd9fb6bbd455fb4dcca9337713b95ff42a41c88b2
OPNSENSE_ISO_SHA256=51ca500465611a559f651eb10be6b3342c07efa0db18c78689dda4266b1ca9a8
